{
  "name": "TCG - Motor de Imágenes Escenario 4 (1UPS/SEM)",
  "description": "Estimación productiva Walmart Chile - Meta 1M precios/semana = 217K fotos/mes (a 20 precios/foto). Powered by Amazon Nova Pro + SageMaker Async g5.2xlarge",
  "services": [
    {
      "service": "dynamodb",
      "group": "Persistencia",
      "description": "Tabla resultados procesamiento (1KB items)",
      "capacityMode": "on-demand",
      "storageGB": 500,
      "avgItemSizeKB": 1
    },
    {
      "service": "dynamodb",
      "group": "Persistencia",
      "description": "Tabla persistencia principal (3KB items)",
      "capacityMode": "on-demand",
      "storageGB": 500,
      "avgItemSizeKB": 3
    },
    {
      "service": "s3",
      "group": "Almacenamiento",
      "description": "Imágenes de góndolas (217K fotos x ~3.5MB)",
      "storageGB": 750,
      "putRequests": 216000,
      "getRequests": 216000
    },
    {
      "service": "s3-vectors",
      "group": "Almacenamiento",
      "description": "Embeddings catálogo SKUs (3K productos)",
      "numberOfIndexes": 1,
      "vectorsPerIndex": 120000,
      "vectorDimensions": 1024,
      "filterableMetadataKB": 2,
      "keySizeKB": 0.5,
      "percentOverwrittenPerMonth": 0.167,
      "totalQueriesPerMonth": 22000
    },
    {
      "service": "s3",
      "group": "FrontEnd",
      "description": "Hosting frontend SPA (estático)",
      "storageGB": 5,
      "putRequests": 1000,
      "getRequests": 50000
    },
    {
      "service": "cloudfront",
      "group": "FrontEnd",
      "description": "CDN + Front (250 MAU scouts y analistas)",
      "pricingModel": "payg",
      "dataOutGB": 100,
      "httpsRequests": 700000
    },
    {
      "service": "waf",
      "group": "FrontEnd",
      "description": "Protección WAF",
      "webAcls": 2,
      "rulesPerAcl": 5
    },
    {
      "service": "cognito",
      "group": "FrontEnd",
      "description": "Auth scouts + analistas",
      "tier": "essentials",
      "mau": 250
    },
    {
      "service": "api-gateway",
      "group": "APIs",
      "description": "HTTP API ingesta fotos + consultas",
      "httpRequests": 0.216
    },
    {
      "service": "lambda",
      "group": "Procesamiento",
      "description": "Orquestación entre servicios",
      "requests": 300000,
      "durationMs": 500,
      "memoryMB": 512
    },
    {
      "service": "step-functions",
      "group": "Procesamiento",
      "description": "Workflow por foto",
      "workflowRequests": 300000,
      "transitionsPerWorkflow": 5
    },
    {
      "service": "sagemaker-async",
      "group": "Procesamiento Imagenes",
      "description": "YOLO + Grounding DINO (visión, bbox)",
      "modelsDeployed": 1,
      "modelsPerEndpoint": 1,
      "instancesPerEndpoint": 1,
      "hoursPerDay": 12,
      "daysPerMonth": 30,
      "instanceType": "ml.g5.2xlarge",
      "storageAmountGB": 100
    },
    {
      "service": "textract",
      "group": "Procesamiento Imagenes",
      "description": "OCR precios de etiquetas",
      "numberOfPages": 216000,
      "percentWithText": 100
    },
    {
      "service": "bedrock",
      "group": "Capa LLM",
      "description": "Nova Pro razonamiento multimodal (1 call/foto)",
      "provider": "Amazon",
      "model": "Nova Pro",
      "requestsPerMinute": 6,
      "hoursPerDay": 20,
      "inputTokensPerRequest": 800,
      "outputTokensPerRequest": 350
    },
    {
      "service": "bedrock-agentcore",
      "group": "Capa Agentica",
      "description": "AgentCore Runtime + Observability",
      "enableObservability": true,
      "sessionsPerMonth": 216000,
      "avgSessionDurationSec": 15,
      "ioWaitPercent": 20,
      "avgVcpu": 2,
      "avgSessionMemoryGB": 5,
      "observabilityLogsGB": 15,
      "observabilitySpansGB": 15
    },
    {
      "service": "athena",
      "group": "Analitica",
      "description": "Consultas analíticas / reporting (Parquet particionado)",
      "queriesPerMonth": 3000,
      "dataScannedPerQueryGB": 1
    },
    {
      "service": "cloudwatch",
      "group": "Observabilidad",
      "description": "Métricas + logs",
      "metrics": 40
    },
    {
      "service": "cloudtrail",
      "group": "Observabilidad",
      "description": "Trazabilidad eventos AWS",
      "mgmtEvents": 5000,
      "mgmtTrails": 3,
      "s3Operations": 30000,
      "s3Trails": 3,
      "lambdaEvents": 10,
      "lambdaTrails": 1,
      "networkEvents": 5000,
      "networkTrails": 1
    }
  ]
}
