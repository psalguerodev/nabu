{
  "name": "TCG - Motor de Imágenes Escenario Base - Claude Sonnet",
  "description": "Escenario Base - 9K fotos/mes (operación inicial estable, tráfico bajo). Powered by Anthropic Claude Sonnet 4.6 + SageMaker Async g5.2xlarge. Misma arquitectura que Escenario 4, ajustada por volumen.",
  "services": [
    {
      "service": "dynamodb",
      "group": "Persistencia",
      "description": "Tabla resultados procesamiento (1KB items)",
      "capacityMode": "on-demand",
      "storageGB": 100,
      "avgItemSizeKB": 1
    },
    {
      "service": "dynamodb",
      "group": "Persistencia",
      "description": "Tabla persistencia principal (3KB items)",
      "capacityMode": "on-demand",
      "storageGB": 100,
      "avgItemSizeKB": 3
    },
    {
      "service": "s3",
      "group": "Almacenamiento",
      "description": "Imágenes de góndolas (9K fotos x ~1.75MB)",
      "storageGB": 50,
      "putRequests": 9000,
      "getRequests": 9000
    },
    {
      "service": "s3-vectors",
      "group": "Almacenamiento",
      "description": "Embeddings catálogo SKUs (3K productos)",
      "numberOfIndexes": 1,
      "vectorsPerIndex": 120000,
      "vectorDimensions": 1024,
      "filterableMetadataKB": 2,
      "keySizeKB": 0.5,
      "percentOverwrittenPerMonth": 0.167,
      "totalQueriesPerMonth": 9000
    },
    {
      "service": "s3",
      "group": "FrontEnd",
      "description": "Hosting frontend SPA (estático)",
      "storageGB": 5,
      "putRequests": 1000,
      "getRequests": 30000
    },
    {
      "service": "cloudfront",
      "group": "FrontEnd",
      "description": "CDN + Front (50 MAU equipo inicial)",
      "pricingModel": "payg",
      "dataOutGB": 10,
      "httpsRequests": 100000
    },
    {
      "service": "waf",
      "group": "FrontEnd",
      "description": "Protección WAF",
      "webAcls": 2,
      "rulesPerAcl": 5
    },
    {
      "service": "cognito",
      "group": "FrontEnd",
      "description": "Auth equipo inicial (scouts + analistas)",
      "tier": "essentials",
      "mau": 50
    },
    {
      "service": "api-gateway",
      "group": "APIs",
      "description": "HTTP API ingesta fotos + consultas",
      "httpRequests": 0.009
    },
    {
      "service": "lambda",
      "group": "Procesamiento",
      "description": "Orquestación entre servicios",
      "requests": 15000,
      "durationMs": 500,
      "memoryMB": 512
    },
    {
      "service": "step-functions",
      "group": "Procesamiento",
      "description": "Workflow por foto",
      "workflowRequests": 12000,
      "transitionsPerWorkflow": 5
    },
    {
      "service": "sagemaker-async",
      "group": "Procesamiento Imagenes",
      "description": "YOLO + Grounding DINO (visión, bbox) - 4h/día baja demanda",
      "modelsDeployed": 1,
      "modelsPerEndpoint": 1,
      "instancesPerEndpoint": 1,
      "hoursPerDay": 4,
      "daysPerMonth": 30,
      "instanceType": "ml.g5.2xlarge",
      "storageAmountGB": 100
    },
    {
      "service": "textract",
      "group": "Procesamiento Imagenes",
      "description": "OCR precios de etiquetas",
      "numberOfPages": 9000,
      "percentWithText": 100
    },
    {
      "service": "bedrock",
      "group": "Capa LLM",
      "description": "Claude Sonnet 4.6 razonamiento multimodal (1 call/foto)",
      "provider": "Anthropic",
      "model": "Claude Sonnet 4.6",
      "requestsPerMinute": 1,
      "hoursPerDay": 5,
      "inputTokensPerRequest": 800,
      "outputTokensPerRequest": 350
    },
    {
      "service": "bedrock-agentcore",
      "group": "Capa Agentica",
      "description": "AgentCore Runtime + Observability",
      "enableObservability": true,
      "sessionsPerMonth": 9000,
      "avgSessionDurationSec": 15,
      "ioWaitPercent": 20,
      "avgVcpu": 2,
      "avgSessionMemoryGB": 5,
      "observabilityLogsGB": 2,
      "observabilitySpansGB": 2
    },
    {
      "service": "athena",
      "group": "Analitica",
      "description": "Consultas analíticas / reporting (volumen bajo)",
      "queriesPerMonth": 1500,
      "dataScannedPerQueryGB": 0.5
    },
    {
      "service": "cloudwatch",
      "group": "Observabilidad",
      "description": "Métricas + logs",
      "metrics": 30
    },
    {
      "service": "cloudtrail",
      "group": "Observabilidad",
      "description": "Trazabilidad eventos AWS",
      "mgmtEvents": 5000,
      "mgmtTrails": 3,
      "s3Operations": 5000,
      "s3Trails": 3,
      "lambdaEvents": 10,
      "lambdaTrails": 1,
      "networkEvents": 5000,
      "networkTrails": 1
    }
  ]
}
