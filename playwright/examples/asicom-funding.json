{
  "name": "ASICOM - Log Perimetrales Funding",
  "description": "Estimación de funding ASICOM Log Perimetrales productivo - 3 ambientes (DEV/QA/PROD) escalados desde el PoV de 1 fuente Wazuh hacia 6 fuentes perimetrales 24/7",
  "services": [
    {
      "service": "lambda",
      "group": "DEV",
      "description": "[DEV] Lambdas de procesamiento (process-start, process-log, glue trigger)",
      "requests": 100000,
      "durationMs": 500,
      "memoryMB": 512
    },
    {
      "service": "lambda",
      "group": "DEV",
      "description": "[DEV] Lambdas de API (get-process, get-history, get-dashboard, presigned-url, etc.)",
      "requests": 200000,
      "durationMs": 200,
      "memoryMB": 256
    },
    {
      "service": "step-functions",
      "group": "DEV",
      "description": "[DEV] ProcessLogsStateMachine - bajo volumen para desarrollo",
      "workflowRequests": 10000,
      "transitionsPerWorkflow": 5
    },
    {
      "service": "api-gateway",
      "group": "DEV",
      "description": "[DEV] HTTP API - requests del frontend de desarrollo",
      "httpRequests": 1
    },
    {
      "service": "eventbridge",
      "group": "DEV",
      "description": "[DEV] EventBridge S3 Notifications + CRON",
      "customEvents": 1
    },
    {
      "service": "dynamodb",
      "group": "DEV",
      "description": "[DEV] Tablas userTable, processTable, logsTable, configTable, executionTable, notificationTable",
      "capacityMode": "on-demand",
      "storageGB": 10
    },
    {
      "service": "s3",
      "group": "DEV",
      "description": "[DEV] Logs raw + clean + reports - dataset reducido",
      "storageGB": 50
    },
    {
      "service": "cognito",
      "group": "DEV",
      "description": "[DEV] User Pool - usuarios del equipo de desarrollo",
      "tier": "lite",
      "mau": 10
    },
    {
      "service": "bedrock",
      "group": "DEV",
      "description": "[DEV] Claude Sonnet 4.6 - throughput mínimo para pruebas puntuales",
      "provider": "Anthropic",
      "model": "Claude Sonnet 4.6",
      "requestsPerMinute": 1,
      "hoursPerDay": 2,
      "inputTokensPerRequest": 2000,
      "outputTokensPerRequest": 500
    },
    {
      "service": "bedrock-agentcore",
      "group": "DEV",
      "description": "[DEV] AgentCore Runtime + Gateway + Observability - sizing mínimo",
      "enableGateway": true,
      "enableObservability": true,
      "sessionsPerMonth": 1000,
      "avgSessionDurationSec": 30,
      "ioWaitPercent": 50,
      "avgVcpu": 1,
      "avgSessionMemoryGB": 1,
      "gatewaySessions": 1000,
      "gatewayTools": 5,
      "gatewaySearchRequests": 3,
      "gatewayToolInvocations": 10,
      "observabilityLogsGB": 2,
      "observabilitySpansGB": 1
    },
    {
      "service": "athena",
      "group": "DEV",
      "description": "[DEV] Queries esporádicas para validación",
      "queriesPerMonth": 30,
      "dataScannedPerQueryGB": 1
    },
    {
      "service": "cloudwatch",
      "group": "DEV",
      "description": "[DEV] Logs y métricas mínimas",
      "metrics": 20
    },
    {
      "service": "xray",
      "group": "DEV",
      "description": "[DEV] Tracing reducido",
      "requestsPerMonth": 100000,
      "samplingRate": 5
    },
    {
      "service": "systems-manager",
      "group": "DEV",
      "description": "[DEV] Parameter Store - configuración",
      "standardParams": 30,
      "apiInteractionsPerParam": 100
    },
    {
      "service": "secrets-manager",
      "group": "DEV",
      "description": "[DEV] Secretos para credenciales Redshift, API keys VirusTotal/AbuseIPDB",
      "numberOfSecrets": 5,
      "avgSecretDurationDays": 30,
      "apiCallsPerMonth": 10000
    },
    {
      "service": "ecr",
      "group": "DEV",
      "description": "[DEV] Imágenes del agente Bedrock AgentCore - dataset reducido",
      "storageGB": 5
    },
    {
      "service": "appsync",
      "group": "DEV",
      "description": "[DEV] GraphQL API - notificaciones de progreso al frontend dev",
      "apiRequestsPerMonth": 100000,
      "enableRealTime": false,
      "enableDataTransfer": false
    },
    {
      "service": "glue",
      "group": "DEV",
      "description": "[DEV] ETL PySpark - normalización de logs (2 DPU × 15 min/día = mínimo AWS)",
      "sparkDpus": 2,
      "sparkMinutesPerMonth": 450
    },

