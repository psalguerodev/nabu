{
  "name": "TCG - Motor de Imágenes Escenario 2 - Claude Sonnet",
  "description": "Escenario 2 - 13K fotos/mes (adopción creciente, tráfico moderado). Powered by Anthropic Claude Sonnet 4.6 + SageMaker Async g5.2xlarge. Misma arquitectura que Escenario 4, ajustada por volumen.",
  "services": [
    {
      "service": "dynamodb",
      "group": "Persistencia",
      "description": "Tabla resultados procesamiento (1KB items)",
      "capacityMode": "on-demand",
      "storageGB": 150,
      "avgItemSizeKB": 1
    },
    {
      "service": "dynamodb",
      "group": "Persistencia",
      "description": "Tabla persistencia principal (3KB items)",
      "capacityMode": "on-demand",
      "storageGB": 150,
      "avgItemSizeKB": 3
    },
    {
      "service": "s3",
      "group": "Almacenamiento",
      "description": "Imágenes de góndolas (13K fotos x ~1.75MB)",
      "storageGB": 75,
      "putRequests": 13000,
      "getRequests": 13000
    },
    {
      "service": "s3-vectors",
      "group": "Almacenamiento",
      "description": "Embeddings catálogo SKUs (3K productos)",
      "numberOfIndexes": 1,
      "vectorsPerIndex": 120000,
      "vectorDimensions": 1024,
      "filterableMetadataKB": 2,
      "keySizeKB": 0.5,
      "percentOverwrittenPerMonth": 0.167,
      "totalQueriesPerMonth": 13000
    },
    {
      "service": "s3",
      "group": "FrontEnd",
      "description": "Hosting frontend SPA (estático)",
      "storageGB": 5,
      "putRequests": 1000,
      "getRequests": 40000
    },
    {
      "service": "cloudfront",
      "group": "FrontEnd",
      "description": "CDN + Front (100 MAU)",
      "pricingModel": "payg",
      "dataOutGB": 25,
      "httpsRequests": 200000
    },
    {
      "service": "waf",
      "group": "FrontEnd",
      "description": "Protección WAF",
      "webAcls": 2,
      "rulesPerAcl": 5
    },
    {
      "service": "cognito",
      "group": "FrontEnd",
      "description": "Auth scouts + analistas",
      "tier": "essentials",
      "mau": 100
    },
    {
      "service": "api-gateway",
      "group": "APIs",
      "description": "HTTP API ingesta fotos + consultas",
      "httpRequests": 0.013
    },
    {
      "service": "lambda",
      "group": "Procesamiento",
      "description": "Orquestación entre servicios",
      "requests": 25000,
      "durationMs": 500,
      "memoryMB": 512
    },
    {
      "service": "step-functions",
      "group": "Procesamiento",
      "description": "Workflow por foto",
      "workflowRequests": 18000,
      "transitionsPerWorkflow": 5
    },
    {
      "service": "sagemaker-async",
      "group": "Procesamiento Imagenes",
      "description": "YOLO + Grounding DINO (visión, bbox) - 6h/día",
      "modelsDeployed": 1,
      "modelsPerEndpoint": 1,
      "instancesPerEndpoint": 1,
      "hoursPerDay": 6,
      "daysPerMonth": 30,
      "instanceType": "ml.g5.2xlarge",
      "storageAmountGB": 100
    },
    {
      "service": "textract",
      "group": "Procesamiento Imagenes",
      "description": "OCR precios de etiquetas",
      "numberOfPages": 13000,
      "percentWithText": 100
    },
    {
      "service": "bedrock",
      "group": "Capa LLM",
      "description": "Claude Sonnet 4.6 razonamiento multimodal (1 call/foto)",
      "provider": "Anthropic",
      "model": "Claude Sonnet 4.6",
      "requestsPerMinute": 1,
      "hoursPerDay": 7,
      "inputTokensPerRequest": 800,
      "outputTokensPerRequest": 350
    },
    {
      "service": "bedrock-agentcore",
      "group": "Capa Agentica",
      "description": "AgentCore Runtime + Observability",
      "enableObservability": true,
      "sessionsPerMonth": 13000,
      "avgSessionDurationSec": 15,
      "ioWaitPercent": 20,
      "avgVcpu": 2,
      "avgSessionMemoryGB": 5,
      "observabilityLogsGB": 3,
      "observabilitySpansGB": 3
    },
    {
      "service": "athena",
      "group": "Analitica",
      "description": "Consultas analíticas / reporting",
      "queriesPerMonth": 2250,
      "dataScannedPerQueryGB": 0.75
    },
    {
      "service": "cloudwatch",
      "group": "Observabilidad",
      "description": "Métricas + logs",
      "metrics": 35
    },
    {
      "service": "cloudtrail",
      "group": "Observabilidad",
      "description": "Trazabilidad eventos AWS",
      "mgmtEvents": 5000,
      "mgmtTrails": 3,
      "s3Operations": 10000,
      "s3Trails": 3,
      "lambdaEvents": 10,
      "lambdaTrails": 1,
      "networkEvents": 5000,
      "networkTrails": 1
    }
  ]
}
